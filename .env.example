# 디스코드 웹훅 URL (GitHub에서는 Secret으로 등록). send_alerts.py만 읽는다 (main.py는 읽지 않음)
DISCORD_WEBHOOK_URL=
# 배포된 사이트 주소 (이전 상태 읽기용)
SITE_URL=https://sora7942.github.io/stella-radar/
# YouTube Data API v3 키 (GitHub에서는 Secret으로 등록). 업데이터(main.py)만 읽고, URL이 아니라 X-Goog-Api-Key 헤더로만 보낸다.
# 없거나 할당량이 초과되면 RSS로 대체한다. 값은 절대 커밋하지 않는다
YOUTUBE_API_KEY=
